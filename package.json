{
  "name": "blogvite-monorepo",
  "version": "1.0.0",
  "description": "BlogVite — React + MongoDB + JWT + OAuth + Three.js blog platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "start": "node backend/server.js",
    "seed": "npm run seed --workspace=database",
    "seed:clear": "npm run seed:clear --workspace=database",
    "install:all": "npm install && npm install --workspace=frontend && npm install --workspace=backend && npm install --workspace=database"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
